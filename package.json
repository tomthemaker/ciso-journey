{
  "name": "ciso-journey",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first CISO Journey with a static TypeScript/Vite build",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && playwright test",
    "test:desktop": "npm test -- --project=chromium",
    "test:mobile": "npm test -- --project=mobile-chromium"
  },
  "engines": {
    "node": ">=24.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module"
}
