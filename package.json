{
  "name": "ciso-journey",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first CISO Journey with a static TypeScript/Vite build",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit",
    "test:desktop": "npm run test:browser -- --project=chromium",
    "test:mobile": "npm run test:browser -- --project=mobile-chromium",
    "test:unit": "node --experimental-strip-types --test tests/*.test.cjs tests/curriculum/*.test.mjs && node scripts/render-curriculum.mjs --check",
    "test:browser": "npm run build && playwright test",
    "sync:start": "node scripts/sync-local.mjs start",
    "sync:reset": "node scripts/sync-local.mjs reset",
    "sync:status": "node scripts/sync-local.mjs status",
    "sync:stop": "node scripts/sync-local.mjs stop",
    "test:sync": "node --experimental-strip-types --test tests/sync/*.test.mjs"
  },
  "engines": {
    "node": ">=24.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "type": "module",
  "dependencies": {
    "ts-fsrs": "5.4.2"
  }
}
